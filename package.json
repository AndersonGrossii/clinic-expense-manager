{
  "name": "clinic-expense-manager",
  "version": "1.0.0",
  "description": "Multi-clinic receipts, invoices and payroll (nóminas) manager with strict per-clinic isolation.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "migrate": "node scripts/migrate.js",
    "seed:user": "node scripts/create-user.js",
    "bootstrap": "node scripts/migrate.js && node scripts/create-user.js",
    "start:prod": "node scripts/migrate.js && node scripts/create-user.js && node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  }
}
