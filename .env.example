# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# ── Server ───────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public origin of the app (used for cookie/security settings)
APP_ORIGIN=http://localhost:3000

# ── PostgreSQL ───────────────────────────────────────
# Used by docker-compose to create the database container
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=clinic_expenses
# Host ports published by docker-compose (5440 avoids clashing with a local PostgreSQL)
DB_PORT=5440
APP_PORT=3000
# Connection string used by the app (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgres://clinic_app:change-me-strong-password@localhost:5440/clinic_expenses
# Set to true for managed providers that require SSL (e.g. Railway public proxy)
PGSSL=false

# ── Auth ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Session length in hours (cookie + JWT)
SESSION_HOURS=7
BCRYPT_ROUNDS=12

# ── Initial user (created on startup if it does not exist) ──
SEED_USER_EMAIL=owner@example.com
SEED_USER_PASSWORD=replace-with-a-strong-password
SEED_USER_NAME=Clinic Owner
# Optional: first clinic created for the seed user
SEED_CLINIC_NAME=Mi Clínica

# ── File storage ─────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=15
